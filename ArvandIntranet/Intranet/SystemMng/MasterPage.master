<%@ Master Language="VB" MasterPageFile="~/MasterPages/PortalShell.master" CodeFile="MasterPage.master.vb" Inherits="MasterPage" %>
<asp:Content ID="AdminHead" ContentPlaceHolderID="PortalHead" runat="server"><asp:ContentPlaceHolder ID="head" runat="server" /></asp:Content>
