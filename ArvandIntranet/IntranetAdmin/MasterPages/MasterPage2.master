<%@ Master Language="VB" CodeFile="MasterPage2.master.vb" Inherits="MasterPages_MasterPage2" %>

<%@ Register Src="../UserControls/MenuWUC.ascx" TagName="MenuWUC" TagPrefix="uc1" %>
<%@ Register Src="../UserControls/SearchWUC.ascx" TagName="SearchWUC" TagPrefix="uc2" %>
<%@ Register Src="~/UserControls/HeaderWUC.ascx" TagName="HeaderWUC" TagPrefix="uc3" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">


<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <link rel="shortcut icon" href="<%# ResolveUrl("~/favicon.ico")%>" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
               <div class="topnav">
            <div class="inner_nav">
                <ul class="news_ticker">
                    <li class="ticker_list">
                        <ul id="ticker_id">
                            <li>
                                <img id="Img1" runat="server" src="~/Images/departman.png" />
                            </li>
                            <li>
                                <p style="font-family:Tahoma; direction:rtl; text-align:right;">"
                                <span class="ticker_name">نام واحد:  
                                </span>
                            </li>
                            <li>
                                <span class="ticker_name">
                                    <asp:Label ID="lblPlantName" runat="server"></asp:Label>
                                </span>
                            </li>
                            <li class="current_user">
                                <img src="~/images/last_events_ico.png" alt="کاربر" runat="server" id="imgLastEvent1" />
                            </li>
                            <li class="ticker_name">کاربر جاری:
                            </li>
                            <li class="ticker_name">
                                <asp:Label ID="lblUserName" runat="server"></asp:Label>
                            </li>
                        </ul>
                    </li>
                </ul>
                <!-- end of ul "news_ticker"!-->
            </div>
            <!-- end of div "inner_nav"!-->
        </div>
        <!-- end of div "topnav"!-->
        <div class="wrap">
           
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <!--end of div "wrap"!-->
        <div class="footer">
            <a href="http://kwsoft.ir">طراحی و تولید شرکت دانش افزار ماهان
            </a>
            <a>
                -
            </a>
              <a runat="server" id ="adminA" href="~/Default/danesh">مدیریت پرتال
            </a>
        </div>
    </form>
</body>
</html>

