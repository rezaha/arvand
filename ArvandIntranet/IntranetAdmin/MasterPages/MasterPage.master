<%@ Master Language="VB" CodeFile="MasterPage.master.vb" Inherits="MasterPage" %>

<%@ Register Src="../UserControls/MenuWUC.ascx" TagName="MenuWUC" TagPrefix="uc1" %>
<%@ Register Src="../UserControls/SearchWUC.ascx" TagName="SearchWUC" TagPrefix="uc2" %>
<%@ Register Src="~/UserControls/HeaderWUC.ascx" TagName="HeaderWUC" TagPrefix="uc3" %>


<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">

    <script type="text/javascript">

        function updateClock() {
            var currentTime = new Date();

            var currentHours = currentTime.getHours();
            var currentMinutes = currentTime.getMinutes();
            var currentSeconds = currentTime.getSeconds();

            // Pad the minutes and seconds with leading zeros, if required
            currentMinutes = (currentMinutes < 10 ? "0" : "") + currentMinutes;
            currentSeconds = (currentSeconds < 10 ? "0" : "") + currentSeconds;

            // Choose either "AM" or "PM" as appropriate
            var timeOfDay = (currentHours < 12) ? "صبح" : "بعد از ظهر";

            // Convert the hours component to 12-hour format if needed
            currentHours = (currentHours > 12) ? currentHours - 12 : currentHours;

            // Convert an hours component of "0" to "12"
            currentHours = (currentHours == 0) ? 12 : currentHours;

            // Compose the string for display
            var currentTimeString = currentHours + ":" + currentMinutes + ":" + currentSeconds + " " + timeOfDay;

            // Update the time display
            document.getElementById("clock").firstChild.nodeValue = currentTimeString;
        }
    </script>


    <link rel="shortcut icon" href="<%# ResolveClientUrl("~/favicon.ico")%>" />

    <script language="javascript" type="text/javascript">
        var acceptLanguage = "<%# SiteLanguage.ToLower%>";
    </script>
    <script src="<%# ResolveClientUrl("~/Scripts/jquery.js")%>" type="text/javascript"></script>
    <script src="<%# ResolveClientUrl("~/Scripts/jquery.jcarousel.min.js")%>" type="text/javascript"></script>
    <script src="<%# ResolveClientUrl("~/Scripts/jquery.pikachoose.js")%>" type="text/javascript"></script>
    <script src="<%# ResolveClientUrl("~/Scripts/jquery.cycle.all.js")%>" type="text/javascript"></script>
    <script src="<%# ResolveClientUrl("~/Scripts/jquery.easing.compatibility.js")%>" type="text/javascript"></script>
    <script src="<%# ResolveClientUrl("~/Scripts/jquery.poshytip.min.js")%>" type="text/javascript"></script>
    <script src="<%# ResolveClientUrl("~/Scripts/list_ticker.js")%>" type="text/javascript"></script>

    <script type="text/javascript">

        function clickButton(e, buttonid) {

            var evt = e ? e : window.event;

            var bt = document.getElementById(buttonid);

            if (bt) {

                if (evt.keyCode == 13) {

                    bt.click();

                    return false;

                }

            }

        }

    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#slide').list_ticker({
                speed: 6000,
                effect: 'slide'
            });
        });
        $(document).ready(function () {
            $('.rules').list_ticker({
                speed: 6000,
                effect: 'fade'
            });
        });
    </script>

    <script type="text/javascript">
        $(document).ready(
            function () {
                if (document.body.className.indexOf("glass-ui") !== -1) { return; }
                $("#pikame").PikaChoose({
                    previous: "قبلی",
                    next: "بعدی",
                    carousel: true,
                    carouselOptions: {
                        wrap: 'circular',
                    }
                });
            });
    </script>

    <script type="text/javascript">
        $(function () {
            $('#s7').cycle({
                // fx: 'scrollHorz',
                prev: '#prev',
                next: '#next',
                speed: 500,
                //after: onAfter,
                //  before: onBefore,
                //speedIn: 1000,
                //speedOut: 600,
                backwards: true,
                pause: true,
                //easeOut: 'easeOutExpo',
                //easeIn: 'easeInOutExpo',
                pauseOnPagerHover: 1
            });
            function onAfter() {
                $('#s7').children('.item1').fadeIn(400);
                $('#s7').children('.item2').delay(200).fadeIn(400);
                $('#s7').children('.item3').delay(400).fadeIn(400);
            }
            function onBefore() {
                $('#s7').children().css({ "display": "none" });
            }

            var pageSize = <%#GetPageSize()%>;
            var imageAddress;
             
            if (pageSize < 960) {
                imageAddress = "<%# ResolveClientUrl("~/Images/slim.png")%>";
                $("body").css("background-image", "url("+imageAddress+")");
                $(".wrap").css("width", pageSize);
            }else if (pageSize < 1200) {
                imageAddress = "<%# ResolveClientUrl("~/Images/slim1.png")%>";
                $("body").css("background-image", "url("+imageAddress+")");
                $(".wrap").css("width", pageSize);
            } else {
                imageAddress = "<%# ResolveClientUrl("~/Images/slim2.png")%>";
                $("body").css("background-image", "url("+imageAddress+")");
                $(".wrap").css("width", pageSize);
            } 
        });
    </script>
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="<%= If(String.Equals(Page.AppRelativeVirtualPath, "~/default.aspx", StringComparison.OrdinalIgnoreCase), "glass-ui", "") %>" onload="updateClock(); setInterval('updateClock()', 1000 )">
    <form id="form1" runat="server">
        <div class="topnav">
            <% If String.Equals(Page.AppRelativeVirtualPath, "~/default.aspx", StringComparison.OrdinalIgnoreCase) Then %>
            <a class="glass-brand" href="<%= ResolveUrl("~/Default.aspx") %>" aria-label="صفحه نخست پتروشیمی اروند">
                <img src="<%= ResolveUrl("~/Images/pet_logo.png") %>" alt="شرکت پتروشیمی اروند" width="259" height="42" />
            </a>
            <% End If %>
            <div class="inner_nav">
                <ul class="news_ticker">
                    <li class="ticker_list">
                        <ul id="ticker_id">
                            <li>
                                <img id="Img1" runat="server" src="~/Images/departman.png" />
                            </li>
                            <li>
                                <span class="ticker_name">نام واحد:  
                                </span>
                            </li>
                            <li>
                                <span class="ticker_name">
                                    <asp:Label ID="lblPlantName" runat="server"></asp:Label>
                                </span>
                            </li>
                            <li class="current_user">
                                <img src="~/images/last_events_ico.png" alt="کاربر" runat="server" id="imgLastEvent1" />
                            </li>
                            <li class="ticker_name">کاربر جاری:
                            </li>
                            <li class="ticker_name">
                                <asp:Label ID="lblUserName" runat="server"></asp:Label>
                            </li>
                            <li class="current_user">
                                <img id="Img2" runat="server" src="~/Images/departman.png" />
                            </li>
                            <li class="ticker_name">تاریخ:
                            </li>
                            <li class="ticker_name">
                                <asp:Label ID="lblDate" runat="server" Text=""></asp:Label>
                                ساعت: 
                                <span id="clock">&nbsp;</span>
                            </li>
                            <li>
                                --
                                <a target="_self" runat="server" id="homePageLink" style="color:#ffffff;" href="~/Default.aspx">
                                    صفحه نخست
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
                <table class="searchbox search">
                    <tr>

                        <td>
                            <asp:TextBox ID="txtSearch" runat="server" Style="font-family: Tahoma; font-size: 11px;"></asp:TextBox></td>
                        <td>
                            <asp:ImageButton ID="imgBtnSearch" runat="server" ImageUrl="~/Images/search_ico.png" />
                        </td>
                    </tr>
                </table>
                <!-- end of ul "news_ticker"!-->
            </div>
            <!-- end of div "inner_nav"!-->
        </div>
        <!-- end of div "topnav"!-->
        <div class="wrap">
            <uc3:HeaderWUC runat="server" ID="HeaderWUC" />
            <!--end of div header !-->
            <div class="glass-menu-host">
                <uc1:MenuWUC ID="MenuWUC1" runat="server" />
            </div>
            <!--end of ul "menu" !-->

            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <!--end of div "wrap"!-->
        <div class="footer">
            <a href="http://kwsoft.ir">طراحی و تولید شرکت دانش افزار ماهان
            </a>
            <a>-
            </a>
            <a runat="server" id="adminA" href="~/Default/danesh">مدیریت پرتال
            </a>
        </div>
    </form>
</body>
</html>



