    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{d486f827-511c-4e73-974f-2f5a46286fef}</ProjectGuid>
    <SourceWebPhysicalPath>$(MSBuildThisFileDirectory)</SourceWebPhysicalPath>
